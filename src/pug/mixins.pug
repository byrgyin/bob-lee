mixin style(name)
    if APP_MODE === 'production'
    link(href=`${name}.css`, rel='stylesheet')

mixin cardProdcut(obj)
    .card
        .card__top-info
            button(data-id-product='1231').card__add-to-wish
                +image({src:'images/wish.svg',klassImg:'card__new-img card__img-wish'})
            if obj.newProduct
                +image({src:'images/icon-new.svg',klassImg:'card__new-img'})
        a(href='/product.html').card__link-img
            +image({src: obj.src, klassImg: 'card__img', klassPic: 'card__pic'})
        .card__bottom-info
            a(href='/product.html').card__link-item=obj.name
            .card__price= obj.price
            .card__count= obj.count


mixin image(obj)
    -
        let type = '';
        if (obj.src && typeof obj.src === 'string') {
            let parts = obj.src.split('.');
            type = parts[parts.length - 1];
        } else {
            console.error('Ошибка в миксине image: src не является строкой или не определен.', obj);
        }

    if type === 'svg'
        if obj.quickLoad
            img(src=obj.src, alt='alt', class=obj.klassImg, loading="eager")
        else
            img(src=obj.src, alt='alt', class=obj.klassImg, loading="lazy")
    else if (type)
        picture(class=obj.klassPic)
            if obj.quickLoad
                img(src=obj.src, alt='alt', class=obj.klassImg, loading="eager")
            else
                img(src=obj.src, alt='alt', class=obj.klassImg, loading="lazy")
    else
        p(style="color: red;") [Image Error: Invalid source provided]